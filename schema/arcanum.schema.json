{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puppup.games/schema/arcanum.schema.json",
  "title": "Stonetop Arcanum (third-party content)",
  "description": "Frontmatter contract for an arcanum. Maps to Sled Dog's ArcanumDef. Do NOT set `number` — Sled Dog assigns third-party deck numbers automatically in a reserved band.",
  "type": "object",
  "required": ["kind", "slug", "summary", "rarity", "author", "author_url", "front", "back"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "arcanum" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case, no leading 'the-'. Sled Dog namespaces it (e.g. ppg:<slug>)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "One or two sentences on what this arcanum does — shown on the party's Manage content page so owners know what they're adding."
    },
    "rarity": { "enum": ["minor", "major"] },
    "location": {
      "type": "boolean",
      "description": "Optional. True if the unrevealed front is a place, not a carried object."
    },
    "stats": {
      "type": "array",
      "description": "Optional. Stats this arcanum's rolls/effects lean on.",
      "items": { "enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"] }
    },
    "author": { "type": "string", "minLength": 1 },
    "author_url": { "type": "string", "format": "uri" },
    "front": {
      "type": "object",
      "description": "The discovery side — what a player sees before the arcanum is unlocked.",
      "required": ["objectName", "tags", "description", "unlockRequirements", "requireCount"],
      "additionalProperties": false,
      "properties": {
        "objectName": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string", "minLength": 1 },
        "unlockRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requireCount": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "null = all requirements needed to reveal; a number = any N of them."
        },
        "load": { "type": "integer", "minimum": 0 },
        "small": { "type": "boolean" },
        "uses": { "type": "integer", "minimum": 0 }
      }
    },
    "back": {
      "type": "object",
      "description": "The arcanum side — revealed once the front's requirements are met.",
      "required": ["arcanumName", "description", "moves"],
      "additionalProperties": false,
      "properties": {
        "arcanumName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "priceText": { "type": "string" },
        "moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "text"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "unlockAtConsequences": {
                "type": "integer",
                "minimum": 1,
                "description": "Optional. Withhold this move until at least N consequences are marked (major arcana)."
              }
            }
          }
        },
        "consequences": {
          "type": "array",
          "description": "Optional. A major arcanum's consequences checklist that moves consume.",
          "items": { "type": "string", "minLength": 1 }
        },
        "follower": {
          "type": "object",
          "description": "Optional. A follower the arcanum grants on reveal.",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "type": { "enum": ["individual", "group", "animal"] },
            "descriptor": { "type": "string" },
            "hp": { "type": "integer", "minimum": 0 },
            "armor": { "type": "integer", "minimum": 0 },
            "damage": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "instinct": { "type": "string" },
            "cost": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "load": { "type": "integer", "minimum": 0 },
        "small": { "type": "boolean" },
        "uses": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
